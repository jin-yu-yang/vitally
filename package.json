{
  "name": "pcdc-vita-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ViTally: a Supabase-backed shared demonstration of a VITA tax-prep workflow — real email sign-in, real shared state between a client and a staff window, simulated documents and preparation steps",
  "scripts": {
    "seed:local": "node --env-file=.env.test tools/admin/seed.mjs",
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "dev": "node --env-file-if-exists=.env.local server.mjs",
    "build:vendor": "node tools/build.mjs",
    "build:intake": "node tools/build-intake-catalogue.mjs",
    "build:hant": "node tools/build-hant.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --env-file=.env.test --test tests/browser.mjs",
    "test:auth-browser": "node --env-file=.env.test --test tests/auth-browser.mjs",
    "test:database": "node --env-file=.env.test --test tests/database*.mjs",
    "db:migrate:test": "node --env-file=.env.test tools/admin/migrate.mjs"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@google/stitch-sdk": "^0.3.5",
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-sc": "0.4.3",
    "@expo-google-fonts/noto-sans-tc": "0.4.3",
    "@fission-ai/openspec": "1.14.0",
    "@pdf-lib/fontkit": "1.1.1",
    "esbuild": "0.28.2",
    "opencc-js": "1.4.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.16.3",
    "playwright": "1.63.0",
    "supabase": "2.117.0"
  }
}
